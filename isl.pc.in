prefix=@PKGCONFIG_PREFIX@
exec_prefix=${prefix}
bindir=@PKGCONFIG_BINDIR@
libdir=@PKGCONFIG_LIBDIR@
datarootdir=@PKGCONFIG_DATAROOTDIR@
datadir=@PKGCONFIG_DATADIR@
sysconfdir=@PKGCONFIG_SYSCONFDIR@
includedir=@PKGCONFIG_INCLUDEDIR@
package=@PROJECT_NAME@
suffix=

Name: @PROJECT_NAME@
Description: @PROJECT_NAME@ Library
Version: @PROJECT_VERSION@
Requires:
Libs: -L${libdir} -lisl
Cflags: -I${includedir}
